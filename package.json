{
  "name": "matterhorn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite app",
    "build": "vite build app && pnpm run build:permalinks && pnpm run stage:dist && pnpm run build:seo && pnpm run check:build && pnpm run check:bundle",
    "build:permalinks": "tsx scripts/build-permalinks.ts",
    "preview": "vite preview app",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "i18n:scan": "tsx scripts/i18n-scan.ts",
    "pipeline": "tsx pipeline/run.ts",
    "icons": "node scripts/gen-icons.mjs",
    "validate:content": "tsx scripts/validate-content.ts --scan-app app/src",
    "test:pipeline": "vitest run --config tests/pipeline/vitest.config.ts",
    "build:content-review": "tsx scripts/build-content-review.ts",
    "build:seo": "tsx scripts/build-seo.ts",
    "check:landing-copy": "tsx scripts/check-landing-copy.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:build": "tsx scripts/check-build.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "token-audit": "tsx scripts/token-audit.ts",
    "audit": "pnpm audit --audit-level high",
    "test:e2e:app": "playwright test --config tests/e2e/app.config.ts",
    "test:e2e:offline": "playwright test --config tests/e2e/preview.config.ts",
    "test:e2e:landing": "playwright test --config tests/e2e/landing.config.ts",
    "test:e2e:research": "playwright test --config tests/e2e/research.config.ts",
    "test:e2e:a11y": "playwright test --config tests/e2e/a11y.config.ts",
    "test:e2e:cross": "playwright test --config tests/e2e/cross-browser.config.ts",
    "test:e2e:motion": "playwright test --config tests/e2e/motion.config.ts",
    "lh": "pnpm build && lhci autorun --config=lighthouserc.json",
    "lh:desktop": "pnpm build && lhci autorun --config=lighthouserc.desktop.json",
    "stage:dist": "tsx scripts/stage-dist.ts",
    "build:replay": "tsx scripts/build-replay.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "html-to-image": "1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@huggingface/transformers": "4.2.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "jsdom": "30.0.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "adm-zip": ">=0.6.0",
      "brace-expansion": ">=5.0.8",
      "sharp": ">=0.35.3",
      "tmp": ">=0.2.6",
      "uuid": ">=11.1.1"
    }
  }
}
